  "fault_matrix": [
    { "fault": "crash", "description": "worker process dies mid-run; lease/state must be recovered", "target_kind": "worker" },
    { "fault": "lost_ack", "description": "delivery acknowledgement lost; scheduler must not double-run", "target_kind": "worker" },
    { "fault": "duplicate_delivery", "description": "packet redelivered; idempotency and fence must block a second irreversible effect", "target_kind": "job" },
    { "fault": "stale_fence", "description": "expired lease token; claim must be rejected, not silently accepted", "target_kind": "worker" },
    { "fault": "partial_artifact", "description": "artifact truncated; validator must fail closed", "target_kind": "job" },
    { "fault": "ssh_disconnect", "description": "route drops mid-run; resume must reconcile the lease", "target_kind": "host" },
    { "fault": "quota_exhaustion", "description": "shared pool hits zero; model rotation is not a quota workaround", "target_kind": "pool" },
    { "fault": "quota_reset", "description": "window refresh restores pool; health must recover", "target_kind": "pool" },
    { "fault": "mount_loss", "description": "mount disappears; writes must fail closed", "target_kind": "host" },
    { "fault": "capability_rejection", "description": "exact model tuple rejected; siblings stay eligible", "target_kind": "pool" },
    { "fault": "missing_human_review", "description": "review window elapses; completion must not be inferred", "target_kind": "job" }
