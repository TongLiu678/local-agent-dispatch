{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-dispatch.dev/schemas/skill_lineage.schema.json",
  "title": "Skill Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_version",
    "lineage_id",
    "child",
    "parents",
    "operation",
    "created_at",
    "proposal_id",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "api_version": {"const": "local-agent-dispatch.skill-lineage.v1"},
    "lineage_id": {"$ref": "#/$defs/identifier"},
    "child": {"$ref": "#/$defs/skill_ref"},
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/skill_ref"}
    },
    "operation": {"enum": ["create", "revise", "merge", "split"]},
    "created_at": {"type": "string", "format": "date-time"},
    "proposal_id": {"$ref": "#/$defs/identifier"},
    "evidence_refs": {"$ref": "#/$defs/nonempty_identifiers"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "nonempty_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "skill_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "version"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/identifier"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "create"}}},
      "then": {"properties": {"parents": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"operation": {"const": "revise"}}},
      "then": {"properties": {"parents": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"operation": {"const": "split"}}},
      "then": {"properties": {"parents": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"operation": {"const": "merge"}}},
      "then": {"properties": {"parents": {"minItems": 2}}}
    }
  ]
}
