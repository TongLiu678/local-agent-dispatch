{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-dispatch.dev/schemas/skill_index.schema.json",
  "title": "Skill Index Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_version",
    "index_id",
    "generated_at",
    "ttl_seconds",
    "evidence_state",
    "source_digest",
    "embedding_model",
    "embedding_dimensions",
    "skills"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "api_version": {"const": "local-agent-dispatch.skill-index.v1"},
    "index_id": {"$ref": "#/$defs/identifier"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ttl_seconds": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "evidence_state": {"enum": ["complete", "unknown"]},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "embedding_model": {"$ref": "#/$defs/identifier"},
    "embedding_dimensions": {"type": "integer", "minimum": 1, "maximum": 4096},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
    },
    "selector": {
      "type": "string",
      "pattern": "^(?:\\*|[a-z0-9][a-z0-9._:-]{0,63})$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "api_version",
        "skill_id",
        "version",
        "title",
        "description",
        "capabilities",
        "facets",
        "platforms",
        "harnesses",
        "estimated_cost",
        "uncertainty",
        "embedding",
        "availability"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "api_version": {"const": "local-agent-dispatch.skill-index.v1"},
        "skill_id": {"$ref": "#/$defs/identifier"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "pattern": "^[^\\r\\n]+$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tag"}
        },
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tag"}
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/selector"}
        },
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/selector"}
        },
        "estimated_cost": {"type": "number", "minimum": 0},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "embedding": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"type": "number"}
        },
        "availability": {"enum": ["available", "unknown", "disabled"]}
      }
    }
  }
}
