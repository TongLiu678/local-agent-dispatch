{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provenance Event v2",
  "type": "object",
  "description": "Causal provenance event for the local-agent-dispatch ledger. Every event must carry a stable event_id, a causal parent (or explicit null), a timestamp, a source, a confidence, a privacy class, and an idempotency key. Prompt bodies and credentials are never stored on events; only references and digests.",
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "event_id": {
      "type": "string",
      "description": "Stable event identifier, normally derived from the idempotency key."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "attempt.queued",
        "attempt.reserved",
        "attempt.claimed",
        "attempt.started",
        "attempt.heartbeat",
        "artifact.observed",
        "attempt.validation",
        "attempt.completed",
        "attempt.failed",
        "attempt.abandoned",
        "attempt.review",
        "claim.promoted",
        "run.segment.started",
        "run.segment.finished",
        "run.segment.adopted",
        "checkpoint.recorded",
        "cleanup.intent"
      ]
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 timestamp."
    },
    "causal_parent": {
      "type": ["string", "null"],
      "description": "event_id of the causal parent, or explicit null for a root event."
    },
    "source": {
      "type": "string",
      "description": "Emission source, e.g. adapter:opencode, legacy_import, liveness_reconciler."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence of the source in this claim, 0..1."
    },
    "privacy_class": {
      "type": "string",
      "enum": ["public", "internal", "private", "unknown"]
    },
    "idempotency_key": { "type": "string" },
    "attempt_id": {
      "type": "string",
      "description": "Stable attempt identifier, required for attempt lifecycle events."
    },
    "mission_id": { "type": "string" },
    "task_id": { "type": "string" },
    "plan_revision_id": { "type": "string" },
    "assignment_id": { "type": "string" },
    "reservation_id": { "type": "string" },
    "policy_version_id": { "type": "string" },
    "run_id": { "type": "string" },
    "segment_id": { "type": "string" },
    "checkpoint_id": { "type": "string" },
    "provider": { "type": "string" },
    "pool_id": { "type": "string" },
    "model_id": { "type": "string" },
    "model_variant": { "type": "string" },
    "cps_digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "worktree_digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "execution_host": { "type": "string" },
    "workload_host": { "type": "string" },
    "mount": { "type": "string" },
    "route": { "type": "string" },
    "validator": { "type": "string" },
    "prompt_ref": { "type": "string" },
    "claim_id": { "type": "string" },
    "review_event_id": { "type": "string" },
    "claim_contract_digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "prompt_digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "artifact_id": { "type": "string" },
    "artifact_digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "outcome": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "decision": {
      "type": "string",
      "enum": ["approve", "abandon", "reroute", "escalate"]
    },
    "evidence_quality": {
      "type": "string",
      "enum": ["full", "legacy_incomplete", "reconciled", "unknown"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "pattern": "^(attempt|artifact)\\."
          }
        }
      },
      "then": { "required": ["attempt_id"] }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "artifact.observed" } }
      },
      "then": { "required": ["artifact_id", "artifact_digest"] }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "attempt.validation" } }
      },
      "then": { "required": ["outcome"] }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "attempt.review" } }
      },
      "then": { "required": ["decision"] }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "claim.promoted" } }
      },
      "then": {
        "required": [
          "attempt_id",
          "claim_id",
          "claim_contract_digest",
          "review_event_id",
          "decision"
        ],
        "properties": { "decision": { "const": "approve" } }
      }
    }
  ],
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "timestamp",
    "causal_parent",
    "source",
    "confidence",
    "privacy_class",
    "idempotency_key"
  ],
  "additionalProperties": true
}
