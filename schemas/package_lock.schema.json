{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-dispatch.dev/schemas/package_lock.schema.json",
  "title": "Local Agent Dispatch Package Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_version",
    "catalog_snapshot_digest",
    "platform",
    "include_optional",
    "roots",
    "packages"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "lock_version": {"type": "string", "const": "1"},
    "catalog_snapshot_digest": {"$ref": "#/$defs/digest"},
    "platform": {"$ref": "#/$defs/target_platform"},
    "include_optional": {"type": "boolean"},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/locked_package"}
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "platform_value": {
      "allOf": [
        {"$ref": "#/$defs/name"},
        {"not": {"const": "any"}}
      ]
    },
    "target_platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"$ref": "#/$defs/platform_value"},
        "arch": {"$ref": "#/$defs/platform_value"}
      }
    },
    "platform_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"$ref": "#/$defs/name"},
        "arch": {"$ref": "#/$defs/name"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "constraint", "optional"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "constraint": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"}
      }
    },
    "locked_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "manifest_digest", "kind", "platforms"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "kind": {
          "type": "string",
          "enum": [
            "system_probe",
            "provider",
            "runtime",
            "transport",
            "validator",
            "agent_harness",
            "batch_scheduler",
            "artifact_store",
            "bundle",
            "skill"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {"$ref": "#/$defs/platform_constraint"}
        }
      }
    }
  }
}
