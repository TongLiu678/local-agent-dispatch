{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-dispatch.dev/schemas/public_export_policy.schema.json",
  "title": "Local Agent Dispatch Public Export Policy",
  "description": "Strict, deterministic selection and literal-redaction policy for an offline public source export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_type",
    "exclude_paths",
    "exclude_prefixes",
    "literal_replacements"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "policy_type": {
      "type": "string",
      "const": "local-agent-dispatch.public_export_policy"
    },
    "exclude_paths": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repository_path"}
    },
    "exclude_prefixes": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repository_path"}
    },
    "literal_replacements": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "match", "replacement", "expected_count"],
        "properties": {
          "path": {"$ref": "#/$defs/repository_path"},
          "match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          },
          "replacement": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          },
          "expected_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Canonical relative POSIX repository path. Runtime validation also rejects empty or dot components, duplicate separators, leading or trailing spaces, trailing dots, .git, Win32 device names (including CONIN$ and CONOUT$), components over 255 UTF-8 bytes, and paths over 1024 UTF-8 bytes.",
      "pattern": "^(?!/)(?! )(?!.*\\/ )(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[ .](?:/|$))[^<>:\"\\\\|?*\\u0000-\\u001f\\u007f]+$"
    }
  }
}
