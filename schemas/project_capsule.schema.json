{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-agent-dispatch/project_capsule.schema.json",
  "title": "ProjectCapsule",
  "description": "Project-scoped paths, scheduler ownership and resource limits; controller SQLite must be known-local.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project_id", "workspace_id", "capsule_generation", "capsule_spec_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "capsule_generation": {"type": "integer", "minimum": 1},
    "status": {"enum": ["unbound", "bound", "retired"]},
    "capsule_spec_digest": {"$ref": "#/$defs/sha256_digest"},
    "source_tree_digest": {"$ref": "#/$defs/sha256_digest"},
    "controller_db_path": {"type": "string", "pattern": "^/"},
    "controller_db_mount_digest": {"$ref": "#/$defs/sha256_digest"},
    "data_root": {"type": "string", "pattern": "^/"},
    "artifact_root": {"type": "string", "pattern": "^/"},
    "tmp_root": {"type": "string", "pattern": "^/"},
    "log_root": {"type": "string", "pattern": "^/"},
    "scheduler_backend": {"type": ["string", "object"]},
    "write_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[^/\\.][^\\]*$"}
    },
    "resource_limits": {"type": "object"},
    "host_id": {"type": "string"},
    "scheduler": {"type": "object"},
    "runtime": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "bound"}}},
      "then": {"required": ["source_tree_digest", "controller_db_path", "controller_db_mount_digest", "data_root", "artifact_root", "tmp_root", "log_root", "scheduler_backend", "write_scopes", "resource_limits"]}
    }
  ],
  "$defs": {
    "sha256_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
